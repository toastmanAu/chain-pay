{
  "doctype": "DocType",
  "name": "Crypto Payee Profile",
  "module": "Crypto Payroll",
  "engine": "InnoDB",
  "naming_rule": "By fieldname",
  "autoname": "field:employee",
  "track_changes": 1,
  "fields": [
    { "fieldname": "employee",        "fieldtype": "Link",   "options": "Employee", "label": "Employee", "reqd": 1, "unique": 1 },
    { "fieldname": "salary_fiat",     "fieldtype": "Currency","label": "Salary (fiat)", "reqd": 1 },
    { "fieldname": "fiat_currency",   "fieldtype": "Link",   "options": "Currency", "label": "Fiat currency", "reqd": 1 },
    { "fieldname": "preferred_chain", "fieldtype": "Select", "label": "Preferred chain",
      "options": "ckb:mainnet\nevm:1\nevm:10\nevm:137\nevm:8453\nevm:42161", "reqd": 1 },
    { "fieldname": "preferred_asset", "fieldtype": "Data",   "label": "Preferred asset symbol", "reqd": 1 },
    { "fieldname": "wallet_address",  "fieldtype": "Data",   "label": "Wallet address", "reqd": 1 },
    { "fieldname": "splits_json",     "fieldtype": "Long Text", "label": "Split payments (JSON)" },
    { "fieldname": "active",          "fieldtype": "Check",  "label": "Active", "default": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1 },
    { "role": "Employee",       "read": 1, "write": 1, "if_owner": 1 }
  ]
}
