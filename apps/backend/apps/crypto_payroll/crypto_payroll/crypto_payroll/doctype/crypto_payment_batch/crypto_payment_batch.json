{
  "doctype": "DocType",
  "name": "Crypto Payment Batch",
  "module": "Crypto Payroll",
  "engine": "InnoDB",
  "naming_rule": "Expression (old style)",
  "autoname": "format:BATCH-{YY}{MM}-{####}",
  "track_changes": 1,
  "is_submittable": 1,
  "fields": [
    { "fieldname": "label",         "fieldtype": "Data",  "label": "Label",         "reqd": 1 },
    { "fieldname": "external_id",   "fieldtype": "Data",  "label": "ChainPay record ID", "unique": 1 },
    { "fieldname": "source_type",   "fieldtype": "Select","label": "Source type", "options": "send\npayroll" },
    { "fieldname": "chain",         "fieldtype": "Data",  "label": "Chain" },
    { "fieldname": "confirmed_at",  "fieldtype": "Datetime", "label": "Confirmed at" },
    { "fieldname": "fiat_currency", "fieldtype": "Data",  "label": "Fiat currency" },
    { "fieldname": "fiat_total_minor", "fieldtype": "Data", "label": "Fiat total (minor units)" },
    { "fieldname": "record_digest", "fieldtype": "Data",  "label": "Immutable record digest", "unique": 1, "read_only": 1 },
    { "fieldname": "payments",      "fieldtype": "Table", "options": "Crypto Payment Line", "label": "Payments" },
    { "fieldname": "journal_entry", "fieldtype": "Link", "options": "Journal Entry", "label": "Journal Entry", "read_only": 1, "allow_on_submit": 1 },
    { "fieldname": "treasury",      "fieldtype": "Link",  "options": "Crypto Wallet", "label": "Treasury" },
    { "fieldname": "cycle_start",   "fieldtype": "Date",  "label": "Cycle start" },
    { "fieldname": "cycle_end",     "fieldtype": "Date",  "label": "Cycle end" },
    { "fieldname": "fx_snapshot",   "fieldtype": "Long Text", "label": "FX snapshot JSON" },
    { "fieldname": "state",         "fieldtype": "Select","label": "State",
      "options": "draft\ncalculated\napproved\nbroadcasted\nconfirmed\nfailed\ncancelled",
      "default": "draft", "reqd": 1 },
    { "fieldname": "pending_tx_id", "fieldtype": "Data",  "label": "Pending tx id (multisig coordinator)" },
    { "fieldname": "tx_hash",       "fieldtype": "Data",  "label": "Broadcast tx hash", "unique": 1 },
    { "fieldname": "safe_tx_hash",  "fieldtype": "Data",  "label": "SafeTx hash", "unique": 1, "read_only": 1 },
    { "fieldname": "safe_address",  "fieldtype": "Data",  "label": "Safe address", "read_only": 1 },
    { "fieldname": "executor_address", "fieldtype": "Data", "label": "Gas-paying executor", "read_only": 1 },
    { "fieldname": "recipient_address", "fieldtype": "Data", "label": "EVM recipient", "read_only": 1 },
    { "fieldname": "confirmed_block_number", "fieldtype": "Data", "label": "Confirmed block", "read_only": 1 },
    { "fieldname": "gas_used", "fieldtype": "Data", "label": "Receipt gas used", "read_only": 1 },
    { "fieldname": "effective_gas_price_wei", "fieldtype": "Data", "label": "Effective gas price (wei)", "read_only": 1 },
    { "fieldname": "gas_fee_wei", "fieldtype": "Data", "label": "Executor-paid gas fee (wei)", "read_only": 1 },
    { "fieldname": "gas_payer", "fieldtype": "Select", "label": "Gas payer", "options": "\nexecutor", "read_only": 1 },
    { "fieldname": "journal_posted","fieldtype": "Check", "label": "Accounting journal posted", "default": 0, "allow_on_submit": 1 }
  ],
  "permissions": [
    { "role": "System Manager", "read": 1, "write": 1, "create": 1, "submit": 1, "delete": 1 }
  ]
}
