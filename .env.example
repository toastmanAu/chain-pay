# ChainPay environment

# --- CKB ---
# Light client mode. Embedded WASM is the default; remote RPC is fallback only.
CKB_NETWORK=mainnet                          # mainnet | testnet
CKB_LIGHT_CLIENT_MODE=embedded               # embedded | remote
CKB_REMOTE_RPC_URL=                          # only used if mode=remote

# --- EVM ---
# Comma-separated list of EVM chain IDs to enable. 1=Ethereum, 42161=Arbitrum, 10=Optimism, 8453=Base, 137=Polygon
EVM_ENABLED_CHAINS=1,42161,10,8453

# Per-chain RPC overrides. Leave blank to use public defaults from viem/wagmi.
EVM_RPC_URL_1=
EVM_RPC_URL_42161=
EVM_RPC_URL_10=
EVM_RPC_URL_8453=

# WalletConnect v2 project id (required only when WalletConnect signer transport is enabled)
WALLETCONNECT_PROJECT_ID=

# Safe Transaction Service relay. Leave blank for self-coordinate mode (default).
SAFE_TX_SERVICE_URL=

# --- Frappe backend (Phase 4) ---
FRAPPE_BASE_URL=http://localhost:8000
FRAPPE_API_KEY=
FRAPPE_API_SECRET=

# --- Pricing (FX snapshot at payment calc time) ---
PRICE_PROVIDER=coingecko                     # coingecko | coinbase | manual
COINGECKO_API_KEY=

# ---- Phase 5 / Slice B: Frappe backend ----
ERPNEXT_IMAGE=frappe/erpnext:version-15
MARIADB_ROOT_PASSWORD=frappe
ADMIN_PASSWORD=admin
SITE_NAME=chainpay.localhost
